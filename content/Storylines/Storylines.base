filters:
  and:
    - 'file.folder == "Storylines"'
    - 'type == "storyline"'
properties:
  file.name:
    displayName: Name
  status:
    displayName: Status
  related-factions:
    displayName: Factions
  related-locations:
    displayName: Locations
views:
  - type: table
    name: Storylines
    order:
      - file.name
      - status
      - related-factions
      - related-locations
